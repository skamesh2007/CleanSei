// ─── Types ────────────────────────────────────────────────────────────────────

type Product = {
  id: number;
  name: string;
  price: number;
  points: number;
  img: string;
};

// ─── Data ─────────────────────────────────────────────────────────────────────

const products: Product[] = [
  { id: 1, name: "Protective Gloves",     price: 120,  points: 50,  img: "/images/protective-gloves.png" },
  { id: 2, name: "Reflective Jacket",     price: 300,  points: 110, img: "/images/reflective-jacket.png" },
