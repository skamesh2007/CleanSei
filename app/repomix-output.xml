            </button>
          </div>

          {/* ── Volunteer Gear ───────────────────────────────────────────── */}
          <section className="animate-in fade-in slide-in-from-bottom-4 duration-500 delay-100">
            <h2 className="text-lg font-semibold text-gray-800 dark:text-foreground mb-3">
              🧤 Volunteer Gear
